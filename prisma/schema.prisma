generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== USERS & AUTH =====

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  phone           String?          @unique
  name            String
  passwordHash    String?
  role            UserRole         @default(COUPLE)
  avatarUrl       String?
  events          Event[]
  venueId         String?
  venue           Venue?           @relation(fields: [venueId], references: [id])
  vendorProfile   VendorProfile?
  vendorReviews   VendorReview[]
  vendorLeads     VendorLead[]
  vendorFavorites VendorFavorite[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum UserRole {
  COUPLE
  VENUE_ADMIN
  VENDOR
  ADMIN
}

// ===== VENUES =====

model Venue {
  id              String          @id @default(cuid())
  name            String
  address         String
  city            String
  maxCapacity     Int
  defaultLayout   Json?
  logoUrl         String?
  contactPhone    String?
  contactEmail    String?
  users           User[]
  events          Event[]
  floorTemplates  FloorTemplate[]
  createdAt       DateTime        @default(now())
}

model FloorTemplate {
  id        String   @id @default(cuid())
  name      String
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  layout    Json
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ===== EVENTS =====

model Event {
  id              String      @id @default(cuid())
  name            String
  type            EventType   @default(WEDDING)
  date            DateTime
  time            String?
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  venueId         String?
  venue           Venue?      @relation(fields: [venueId], references: [id])

  // Settings
  minGuarantee    Int?
  pricePerPlate   Float?
  reservePercent  Float?      @default(10)

  // Relations
  guests          Guest[]
  groups          GuestGroup[]
  tables          EventTable[]
  gifts           Gift[]
  tasks           Task[]
  vendorLeads     VendorLead[]

  // Floor plan
  floorPlan       Json?

  // Invitation
  inviteDesign    Json?
  miniSiteSlug    String?     @unique
  miniSiteConfig  Json?

  // Stats cache
  confirmedCount  Int         @default(0)
  declinedCount   Int         @default(0)
  pendingCount    Int         @default(0)
  totalSeated     Int         @default(0)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum EventType {
  WEDDING
  BAR_MITZVAH
  BAT_MITZVAH
  BRIT
  BIRTHDAY
  CORPORATE
  OTHER
}

// ===== GUEST GROUPS =====

model GuestGroup {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  side        GuestSide
  color       String     @default("#3B82F6")
  priority    Int        @default(5)
  proximity   Json?
  guests      Guest[]
  createdAt   DateTime   @default(now())
}

enum GuestSide {
  GROOM
  BRIDE
  SHARED
}

// ===== GUESTS =====

model Guest {
  id              String       @id @default(cuid())
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  firstName       String
  lastName        String?
  phone           String?
  email           String?

  groupId         String?
  group           GuestGroup?  @relation(fields: [groupId], references: [id])
  side            GuestSide    @default(SHARED)
  relation        String?

  rsvpStatus      RsvpStatus   @default(PENDING)
  rsvpCount       Int          @default(1)
  invitedCount    Int          @default(1)
  rsvpDate        DateTime?
  rsvpMethod      String?

  tableId         String?
  table           EventTable?  @relation(fields: [tableId], references: [id])
  seatNumber      Int?

  dietaryNeeds    String?
  accessibility   String?
  hasChildren     Boolean      @default(false)
  childrenCount   Int          @default(0)
  childrenAges    String?

  needsTransport  Boolean      @default(false)
  transportNote   String?

  messages        GuestMessage[]
  gifts           Gift[]

  notes           String?
  vipLevel        Int          @default(0)
  proximityScores Json?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([eventId, rsvpStatus])
  @@index([eventId, groupId])
  @@index([eventId, tableId])
}

enum RsvpStatus {
  PENDING
  CONFIRMED
  DECLINED
  MAYBE
  NO_RESPONSE
}

// ===== TABLES =====

model EventTable {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  number      Int
  name        String?
  shape       TableShape @default(ROUND)
  capacity    Int        @default(10)

  posX        Float      @default(0)
  posY        Float      @default(0)
  rotation    Float      @default(0)
  width       Float?
  height      Float?
  radius      Float?

  isLocked    Boolean    @default(false)
  isVIP       Boolean    @default(false)
  zone        String?

  guests      Guest[]

  createdAt   DateTime   @default(now())

  @@unique([eventId, number])
}

enum TableShape {
  ROUND
  RECTANGLE
  SQUARE
  OVAL
  LONG
}

// ===== GIFTS =====

model Gift {
  id              String    @id @default(cuid())
  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guestId         String?
  guest           Guest?    @relation(fields: [guestId], references: [id])

  type            GiftType
  amount          Float?
  currency        String    @default("ILS")
  description     String?

  paymentId       String?
  paymentStatus   String?

  checkNumber     String?
  bankName        String?
  envelopeNumber  Int?

  receivedAt      DateTime  @default(now())
  notes           String?

  createdAt       DateTime  @default(now())
}

enum GiftType {
  CASH
  CHECK
  CREDIT_CARD
  TRANSFER
  BIT
  PAYBOX
  PHYSICAL
  OTHER
}

// ===== MESSAGES =====

model GuestMessage {
  id          String   @id @default(cuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)

  type        String
  direction   String
  template    String?
  content     String
  status      String

  sentAt      DateTime @default(now())
}

// ===== TASKS =====

model Task {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  category    String?
  priority    Int       @default(5)

  createdAt   DateTime  @default(now())
}

// ===== VENDOR MARKETPLACE =====

enum VendorStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum VendorSubscriptionTier {
  FREE
  BASIC
  PREMIUM
  DIAMOND
}

enum LeadStatus {
  NEW
  VIEWED
  CONTACTED
  IN_PROGRESS
  WON
  LOST
  EXPIRED
}

enum CommissionStatus {
  PENDING
  INVOICED
  PAID
  WAIVED
}

model VendorCategory {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  icon        String
  description String?
  image       String?
  order       Int             @default(0)
  isActive    Boolean         @default(true)
  vendors     VendorProfile[]
  createdAt   DateTime        @default(now())
}

model VendorProfile {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Basic Info
  businessName      String
  slug              String                 @unique
  bio               String?                @db.Text
  shortDescription  String?

  // Category
  categoryId        String
  category          VendorCategory         @relation(fields: [categoryId], references: [id])
  subcategories     String[]

  // Location
  city              String
  areasServed       String[]

  // Contact
  contactPhone      String?
  contactEmail      String?
  website           String?
  instagramUrl      String?
  facebookUrl       String?
  tiktokUrl         String?
  whatsappNumber    String?

  // Media
  logoUrl           String?
  coverUrl          String?

  // Business Details
  priceRangeMin     Int?
  priceRangeMax     Int?
  currency          String                 @default("ILS")
  experienceYears   Int?
  eventsCompleted   Int?                   @default(0)

  // Availability
  availabilityNote  String?
  bookedDates       DateTime[]

  // Flags
  isFeatured        Boolean                @default(false)
  isVerified        Boolean                @default(false)
  status            VendorStatus           @default(DRAFT)

  // Ratings (denormalized)
  ratingAverage     Float                  @default(0)
  reviewCount       Int                    @default(0)

  // Subscription
  subscriptionTier  VendorSubscriptionTier @default(FREE)
  subscriptionEnds  DateTime?

  // Profile completion
  completionScore   Int                    @default(0)

  // Relations
  images            VendorImage[]
  packages          VendorPackage[]
  reviews           VendorReview[]
  leads             VendorLead[]
  favorites         VendorFavorite[]

  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([categoryId, status])
  @@index([city, status])
  @@index([status, isFeatured])
  @@index([ratingAverage])
}

model VendorImage {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  url       String
  publicId  String?
  caption   String?
  altText   String?
  order     Int           @default(0)
  width     Int?
  height    Int?

  createdAt DateTime      @default(now())

  @@index([vendorId, order])
}

model VendorPackage {
  id          String        @id @default(cuid())
  vendorId    String
  vendor      VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  name        String
  description String?       @db.Text
  price       Float?
  currency    String        @default("ILS")
  features    String[]
  isPopular   Boolean       @default(false)
  isActive    Boolean       @default(true)
  order       Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([vendorId, order])
}

model VendorReview {
  id              String        @id @default(cuid())
  vendorId        String
  vendor          VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])

  rating          Int
  title           String?
  text            String?       @db.Text
  eventType       String?
  eventDate       DateTime?

  vendorResponse  String?       @db.Text
  respondedAt     DateTime?

  isVerified      Boolean       @default(false)
  isPublished     Boolean       @default(true)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([vendorId, userId])
  @@index([vendorId, isPublished])
  @@index([rating])
}

model VendorLead {
  id               String            @id @default(cuid())
  vendorId         String
  vendor           VendorProfile     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id])
  eventId          String?
  event            Event?            @relation(fields: [eventId], references: [id])

  contactName      String
  contactPhone     String?
  contactEmail     String?
  eventDate        DateTime?
  eventType        String?
  guestCount       Int?
  message          String?           @db.Text
  budget           Float?

  status           LeadStatus        @default(NEW)
  phoneRevealed    Boolean           @default(false)
  phoneRevealedAt  DateTime?

  dealAmount       Float?
  commissionRate   Float?
  commissionAmount Float?
  commissionStatus CommissionStatus?

  vendorNotes      String?           @db.Text

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([vendorId, status])
  @@index([userId])
  @@index([createdAt])
}

model VendorFavorite {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  createdAt DateTime      @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
}
